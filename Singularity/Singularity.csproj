<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

        <RuntimeIdentifier>linux-x64</RuntimeIdentifier>
        <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>
        <LangVersion>14</LangVersion>
        <TieredPGO>false</TieredPGO>
        <UserSecretsId>ae5d135e-a4f5-4c15-950b-9e1a2021dad3</UserSecretsId>
    </PropertyGroup>

    <!-- A plain build/run/test is framework-dependent (fast, no extra packs). `dotnet publish` produces a standalone,
         precompiled (ReadyToRun) single file. The offline Nix build overrides these with -p:SelfContained=false etc. -->
    <PropertyGroup Condition="'$(_IsPublishing)' == 'true'">
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
        <PublishTrimmed>true</PublishTrimmed>
        <TrimMode>link</TrimMode>
        <PublishReadyToRun>true</PublishReadyToRun>
        <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
        <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    </PropertyGroup>

    <ItemGroup>
        <EmbeddedResource Include="Observability\dashboard.html" LogicalName="dashboard.html" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="DisCatSharp.Voice.Natives" Version="10.7.0" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.2" />
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.2" />
        <PackageReference Include="NetCord" Version="1.0.0-alpha.490" />
        <PackageReference Include="NetCord.Hosting" Version="1.0.0-alpha.490" />
        <PackageReference Include="NetCord.Hosting.Services" Version="1.0.0-alpha.490" />
        <PackageReference Include="NetCord.Services" Version="1.0.0-alpha.490" />
        <PackageReference Include="Sodium.Core" Version="1.4.1" />
        <PackageReference Include="YoutubeExplode" Version="6.6.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- Local runs read appsettings.json from the build output, but a published build must never ship a token. -->
        <None Update="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
            <CopyToPublishDirectory>Never</CopyToPublishDirectory>
        </None>
    </ItemGroup>

    <ItemGroup>
        <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
            <_Parameter1>Singularity.Tests</_Parameter1>
        </AssemblyAttribute>
    </ItemGroup>

</Project>
